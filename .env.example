# Copy to .env.local for local development and set the same variables on the host.

# Resend API key with sending access for the altivexit.com domain.
RESEND_API_KEY=

# Optional. Sender shown on contact form emails (must use the verified domain).
CONTACT_FROM_EMAIL="AltivexIT Website <website@altivexit.com>"

# Optional. Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=procurement@altivexit.com
